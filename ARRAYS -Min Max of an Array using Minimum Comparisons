class Solution {
  public:
    vector<int> getMinMax(vector<int> &arr) {
        int n;
        n=arr.size();
        int i,min,max;
        if(n%2==0){
            if(arr[0]>arr[1]) {max=arr[0];
                min=arr[1];
            }
            else{max=arr[1];
                min=arr[0];
            }
            i=2;
        }//if my number is even
        else{ max=arr[0];
            min=arr[0];
            i=1;
            
        }//if num is odd 
        
        while(i<n-1){
            if(arr[i]>arr[i+1]){
                if(arr[i]>max) max=arr[i];
                if(arr[i+1]<min) min=arr[i+1];
            }
            else{
                if(arr[i+1]>max) max=arr[i+1];
                if(arr[i]<min) min=arr[i];
            }
            i+=2;
        }
      return {min,max};  
    }
};
